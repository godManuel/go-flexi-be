const { calcNetAmount } = require("../utils/calcAmount");
const axios = require("axios");
const asyncHandler = require("../middlewares/async");
const Deposit = require("../models/Deposit");
const User = require("../models/User");
const ErrorResponse = require("../utils/errorResponse");

exports.stroWallet = asyncHandler(async (req, res, next) => {
  const input = req.body;

  if (!input.sessionId) {
    console.error("Webhook missing sessionId");
    return next(new ErrorResponse("Missing sessionID", 400));
  }

  // const url = "https://strowallet.com/api/verifysessionid/";

  try {
    // const response = await axios.get(url, {
    //   headers: {
    //     accept: "application/json",
    //   },
    //   params: {
    //     public_key: process.env.STROWALLET_PUBLIC_KEY,
    //     sessionId: input.sessionId,
    //     amount: input.settledAmount,
    //   },
    // });

    // console.log(response.data);

    let user = await User.findOne({ accountNumber: input.accountNumber });
    console.log(user);
    if (!user) return next(new ErrorResponse("Not account owner!", 400));

    const deposit = await Deposit.create({
      sessionId: input.sessionId,
      accountNumber: input.accountNumber,
      tranRemarks: input.tranRemarks,
      transactionAmount: input.transactionAmount,
      settledAmount: input.settledAmount,
      feeAmount: input.feeAmount,
      vatAmount: input.vatAmount,
      currency: input.currency,
      initiationTranRef: input.initiationTranRef,
      settlementId: input.settlementId,
      sourceAccountNumber: input.sourceAccountNumber,
      sourceAccountName: input.sourceAccountName,
      sourceBankName: input.sourceBankName,
      channelId: input.channelId,
      tranDateTime: input.tranDateTime,
      user,
    });

    await deposit.save();

    const { netAmount } = calcNetAmount(deposit.settledAmount);

    const newAcctBal = netAmount.toFixed(2) + user.accountBalance;

    const updatedUser = await User.findOneAndUpdate(
      { _id: user.id },
      { $set: { accountBalance: newAcctBal } },
      { new: true }
    );

    console.log(updatedUser);

    res.status(201).json({ status: "success", updatedUser });
  } catch (error) {
    const apiError = error.response?.data || error.message;
    return next(
      new ErrorResponse(
        `StroWallet session verification failed: ${JSON.stringify(apiError)}`
      )
    );
  }
});
