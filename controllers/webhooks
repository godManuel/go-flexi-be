const asyncHandler = require("../middlewares/async");
const User = require("../models/User");
const ErrorResponse = require("../utils/errorResponse");

exports.createAccount = asyncHandler(async (req, res, next) => {
  // res.json({ status: "ok" });

  const event = req.body;

  console.log("Webhook from StroWallet:", event);

  if (event.type === "virtual_account.created") {
    const userId = event.data.user_id;
    const accountDetails = event.data.account;

    // Update your DB with the virtual account info
    // await db.users.update(userId, { virtualAccount: accountDetails });
    const virtualAcc = new User(accountDetails);
    await virtualAcc.save();

    console.log(
      `Virtual account created for user ${userId} with account details: ${accountDetails}`
    );

    res.status(200).json({
      success: true,
      data: virtualAcc,
    });
  } else {
    return next(new ErrorResponse("Try again!"));
  }
});
